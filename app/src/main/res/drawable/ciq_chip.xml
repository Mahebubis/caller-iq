<?xml version="1.0" encoding="utf-8"?>
<!-- Outcome chip inside the post-call notification. Neutral fill and outline so it reads on both
     the light and dark notification shades. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="#33888888" />
    <solid android:color="#14888888" />
</shape>
