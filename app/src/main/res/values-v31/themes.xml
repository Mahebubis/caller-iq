<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+: the system splash shows the CallIQ mark on the intro's night colour (no icon
        plate), then hands straight over to the React Native intro, which starts on the same colour
        with the same mark in the same place.
    -->
    <style name="Theme.Calliq" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/ciq_splash</item>
        <item name="android:navigationBarColor">@color/ciq_splash</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/ciq_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
